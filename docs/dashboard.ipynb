    "storage_allocation_df = pd.read_csv(DATA_PATH / 'storage_request.csv',skipinitialspace=True)\n",
    "storage_allocation_df['end_date'] = pd.to_datetime(storage_allocation_df['end_date'], errors='coerce')\n",
    "\n",
    "today = pd.Timestamp(dt.datetime.today().date())\n",
    "\n",
    "# Keep rows where end_date is NA OR end_date >= today\n",
    "storage_allocation_df = storage_allocation_df[storage_allocation_df['end_date'].isna() | (storage_allocation_df['end_date'] >= today)]\n",
    "\n",
    "# Only plot gdata for now\n",
    "storage_allocation_df = storage_allocation_df[(storage_allocation_df['filesystem'] == "gdata")]\n",
    "\n",
    "# Store the lists of projects with allocations \n",
    "alloc_projects = storage_allocation_df.project.unique()\n",
    "\n",
    "# Create a multi-index\n",
    "Index=pd.MultiIndex.from_frame(storage_allocation_df[['project','user']])\n",
    "storage_allocation_df.set_index(Index,inplace=True)\n",
    "storage_allocation_df = storage_allocation_df['allocation'].to_frame()"
