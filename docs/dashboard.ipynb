    "from nci_account import nci_account\n",
    "from nci_resource_tools.read_project import retrieve_project_data, create_storage_df\n",
    "from nci_resource_tools.check_allocation import check_allocation, create_user_table\n",
    "from nci_resource_tools.check_storage import convert_size_to_bytes, convert_bytes_to_size, find_largest_users, load_storage_allocations, create_table_storage_user\n",
    "from config import *"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5b43d248-1fb5-4778-b73c-35285291a1c7",
   "metadata": {},
   "outputs": [],
   "source": [
    "SU_df_dict1, grant_dict, storage_dict = retrieve_project_data()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "1771085d",
   "metadata": {},
   "outputs": [],
   "source": [
    "SU_df_dict = {}\n",
    "for i,project in enumerate(SU_df_dict1.keys()):\n",
    "    \n",
    "    user_totals = SU_df_dict1[project].groupby('user')['usage'].sum()\n",
    "    top_users = user_totals.nlargest(5)\n",
    "    if len(user_totals) > 5:\n",
    "        other_total = user_totals.sort_values(ascending=False).iloc[5:].sum()\n",
    "        top_users['other users'] = other_total\n",
    "    SU_df_dict[project] = top_users\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "e92797d5",
   "metadata": {},
   "outputs": [],
   "source": [
    "du_dict = find_largest_users(COE_PROJECTS, filesystem='gdata')\n",
    "user_storage_dict = {}\n",
    "for project in COE_PROJECTS:\n",
    "    \n",
    "    user_totals = du_dict[project].groupby('USER')['TOTAL SIZE'].sum()\n",
    "    top_users = user_totals.nlargest(5)\n",
    "    if len(user_totals) > 5:\n",
    "        other_total = user_totals.sort_values(ascending=False).iloc[5:].sum()\n",
    "        top_users['other users'] = other_total\n",
    "    user_storage_dict[project] = top_users\n",
    "\n",
    "user_storage_numeric=pd.concat(user_storage_dict)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "ecf21202",
   "metadata": {},
   "outputs": [],
   "source": [
    "colormap = list(tab20.colors) + list(Dark2.colors) + list(Set2.colors) #40 colors should be enough\n",
    "color_cycle = itertools.cycle(colormap)\n",
    "users = set()\n",
    "\n",
    "for i,project in enumerate(SU_df_dict.keys()):\n",
    "    users.update(SU_df_dict[project].index.values)\n",
    "\n",
    "for project in COE_PROJECTS:\n",
    "    users.update(user_storage_numeric[project].index.values)\n",
    "\n",
    "user_colors = {user: next(color_cycle) for user in sorted(users)}\n",
    "default_color = (0.5, 0.5, 0.5) #in case a user is not the list\n"
   ]
  },
