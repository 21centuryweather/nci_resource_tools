    "allocation_storage = load_storage_allocations(DATA_PATH)\n",
    "du_dict = find_largest_users(COE_PROJECTS, filesystem='gdata scratch')\n",
    "\n",
    "itables.show(create_table_storage_user(du_dict,\n",
    "                          allocation_storage,\n",
    "                          gdata_default_limits={'gb02': '70G', 'fy29': '200G', 'if69': '200G', 'ng72': '200G'},\n",
    "                          scratch_default_limits={'gb02': '1T', 'fy29': '1T', 'if69': '1T', 'ng72': '1T'}), \n",
    "    allow_html=True,\n",
    "    columnControl=[\n",
    "        {\"target\": 0, \"content\": [\"order\"]},\n",
    "        {\"target\": 1, \"content\": [\"search\"]},\n",
    "    ],\n",
    "    ordering={\"indicators\": False, \"handler\": False},\n",
    "    scrollY=\"600px\",\n",
    "    paging=False,\n",
    "    columnDefs=[\n",
    "        {\"className\": \"dt-right\", \"targets\": [4, 5]},\n",
    "        {\"width\": \"40%\", \"targets\": [6]},\n",
    "    ],\n",
    "    style=\"width:100%;margin:auto\",\n",
    ")"
   ]
